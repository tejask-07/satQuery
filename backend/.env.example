# -----------------------------------------------------------------------------
# SatQuery AI - Backend Environment Variables
# -----------------------------------------------------------------------------

# Allowed CORS Origins (comma separated)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Planetary Computer / Sentinel STAC Config (Optional overrides)
SENTINEL_STAC_URL=https://planetarycomputer.microsoft.com/api/stac/v1
SENTINEL_SAS_SIGN_URL=https://planetarycomputer.microsoft.com/api/sas/v1/sign

# Cache Directory
SATQUERY_CACHE_DIR=backend/data/cache
